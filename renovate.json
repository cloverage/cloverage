{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "automerge": false,
  "enabledManagers": [
    "leiningen",
    "deps-edn",
    "github-actions",
    "custom.regex"
  ],
  "ignoreDeps": [
    "cloverage",
    "cloverage/cloverage",
    "lein-cloverage",
    "lein-cloverage/lein-cloverage"
  ],
  "ignorePaths": [
    "**/target/**",
    "**/pom.xml"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "org.clojure/clojure"
      ],
      "matchCurrentVersion": "/^1\\.11\\./",
      "allowedVersions": "/^1\\.11\\./"
    },
    {
      "matchPackageNames": [
        "org.clojure/clojure"
      ],
      "matchCurrentVersion": "/^1\\.12\\./",
      "allowedVersions": "/^1\\.12\\./"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.*\\.yml$/"
      ],
      "matchStrings": [
        "bb: (?<currentValue>[0-9.]+)"
      ],
      "depNameTemplate": "babashka/babashka",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.*\\.yml$/"
      ],
      "matchStrings": [
        "lein: (?<currentValue>[0-9.]+)"
      ],
      "depNameTemplate": "technomancy/leiningen",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^bb\\.edn$/"
      ],
      "matchStrings": [
        "antq \\{:mvn/version \\\\\"(?<currentValue>[0-9.]+)\\\\\""
      ],
      "depNameTemplate": "com.github.liquidz/antq",
      "datasourceTemplate": "clojure"
    }
  ]
}
