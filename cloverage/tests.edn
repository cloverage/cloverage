#kaocha/v1
{:tests [{:id :unit}
         {:id :clj12
          :test-paths ["test-clj12"]
          :ns-patterns ["-test-clj12$"]
          :kaocha.testable/skip #profile {:clj12 false :default true}}]
 :kaocha.plugin.randomize/randomize? false
 :cloverage/opts
 {:ns-exclude-regex [],
  :text? false,
  :lcov? false,
  :high-watermark 80,
  :fail-threshold 0,
  :line-fail-threshold 0,
  :form-fail-threshold 0,
  :output "target/coverage",
  :low-watermark 50,
  :ns-regex [],
  :summary? true,
  :coveralls? false,
  :emma-xml? false,
  :html? true,
  :nop? false,
  :codecov? false}}
